{
  "realm": "relay",
  "displayName": "Relay",
  "enabled": true,

  "loginTheme": "relay",
  "emailTheme": "relay",

  "sslRequired": "external",

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,

  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,

  "smtpServer": {
    "host": "smtp.resend.com",
    "port": "587",
    "from": "${EMAIL_FROM}",
    "fromDisplayName": "Relay",
    "auth": "true",
    "user": "resend",
    "password": "${RESEND_API_KEY}",
    "ssl": "false",
    "starttls": "true"
  },

  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 50
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": true,
      "priority": 60
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": true,
      "defaultAction": false,
      "priority": 100
    }
  ],

  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 2592000,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 30,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 3600,

  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ar", "fr", "es", "de"],
  "defaultLocale": "en",

  "actionTokenGeneratedByUserLifespan": 3600,

  "passwordPolicy": "length(8) and maxLength(20) and upperCase(1) and lowerCase(1) and specialChars(1) and notUsername() and notEmail()",

  "clients": [
    {
      "clientId": "account",
      "name": "${client_account}",
      "description": "${client_account_description}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "frontchannelLogout": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "account-console",
      "name": "${client_account_console}",
      "description": "Account console - users manage their sessions, devices, apps, and password",
      "enabled": true,
      "protocol": "openid-connect",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/relay/account/",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "/realms/relay/account/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "relay-frontend",
      "name": "Relay Web App",
      "description": "Angular SPA - public OIDC client with PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200",
        "http://localhost:4200/",
        "http://localhost:4200/silent-check-sso.html"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "relay-admin",
      "name": "Relay Backend Admin",
      "description": "Confidential service-account client for the Keycloak Admin REST API (account deletion, AC-01-07)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${KC_ADMIN_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": []
    }
  ],

  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "guiOrder": "1"
      }
    },
    {
      "alias": "facebook",
      "providerId": "facebook",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "config": {
        "clientId": "${FACEBOOK_CLIENT_ID}",
        "clientSecret": "${FACEBOOK_CLIENT_SECRET}",
        "guiOrder": "2"
      }
    }
  ],

  "users": [],

  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "delete-account",
        "description": "Allows the user to delete their own account",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-relay",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "delete-account"
          ],
          "client": {
            "account": [
              "manage-account",
              "view-profile",
              "manage-account-links"
            ]
          }
        },
        "clientRole": false
      }
    ],
    "client": {
      "account": [
        { "name": "manage-account",       "description": "${role_manage-account}",       "composite": false, "clientRole": true },
        { "name": "view-profile",         "description": "${role_view-profile}",         "composite": false, "clientRole": true },
        { "name": "manage-account-links", "description": "${role_manage-account-links}", "composite": false, "clientRole": true }
      ]
    }
  },

  "defaultRole": {
    "name": "default-roles-relay",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  }
}
