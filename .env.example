# Copy to .env and adjust. .env is gitignored.

# ── Docker Compose infrastructure ─────────────────────────────
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Relay backend (Spring Boot) ───────────────────────────────
# Consumed by application-dev.yaml / application-prod.yaml via ${VAR:default}
# Values below mirror the dev defaults; change them only if your setup differs.
POSTGRES_HOST=localhost
REDIS_HOST=localhost
REDIS_PORT=6379
KEYCLOAK_SERVER_URL=http://localhost:9090

# Keycloak service-account client used by the Admin API (account deletion).
# The client itself is created later by the realm config (Task 12).
KC_ADMIN_CLIENT_ID=relay-admin
KC_ADMIN_CLIENT_SECRET=change-me

# Resend transactional email (D-19). Real key needed only when sending real mail.
RESEND_API_KEY=change-me
EMAIL_FROM=no-reply@relay.local

# Social login brokers (AC-01-04, D-20). Get from Google Cloud Console /
# Meta for Developers; see task 8 notes for the redirect URIs to register.
GOOGLE_CLIENT_ID=unset
GOOGLE_CLIENT_SECRET=unset
FACEBOOK_CLIENT_ID=unset
FACEBOOK_CLIENT_SECRET=unset

# SPRING_PROFILES_ACTIVE=dev   # uncomment to force a profile
